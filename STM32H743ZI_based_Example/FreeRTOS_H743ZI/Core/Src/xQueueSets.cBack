void FreeRTOSTestFun(uint8_t val)
{

	uint8_t datasize1 = sizeof(struct Adata);
	uint8_t datasize2 = sizeof(struct AdataComb);
	(void)datasize1;
	(void)datasize2;

	xQueueHandle1 = xQueueCreate(QUEUE1SIZE_T, sizeof(struct Adata));
	if(xQueueHandle1 == NULL)
	{
		// Queue creation error.
		vTaskDelay(1000);
	}

	xQueueHandle2 = xQueueCreate(QUEUE2SIZE_T, (30*sizeof(uint8_t)));
	if(xQueueHandle2 == NULL)
	{
		// Queue creation error.
		vTaskDelay(1000);
	}

	semHandle = xSemaphoreCreateBinary();

	xQueueSet_1 = xQueueCreateSet(QUEUESET_1_SIZE);

	xQueueAddToSet(xQueueHandle1, xQueueSet_1);
	xQueueAddToSet(xQueueHandle2, xQueueSet_1);
	xQueueAddToSet(semHandle, xQueueSet_1);


	 if(xTaskCreate(monitorTask,
	  			"SampleTask",
	  			STACK_SIZE,
	  			(uint8_t *)&Tasknum,
	  			tskIDLE_PRIORITY + 3,
	  			&task1Handle) == pdFAIL)
	  	{
	  	// Task created
	  		while(1);
	  	}

	    Tasknum = 10;
	  	if(xTaskCreate(Task2,
	  				"Task2",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 2,
	  				&task1Handle2) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	Tasknum = 20;
	  	if(xTaskCreate(Task3,
	  				"Task3",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 1,
	  				&task1Handle3) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	if(xTaskCreate(Task4,
	  		  				"Task4",
	  		  				STACK_SIZE,
	  						(uint8_t *)&Tasknum,
	  		  				tskIDLE_PRIORITY + 1,
	  		  				&task1Handle4) == pdFAIL)
		{
			while(1);
		}

//	  	if(xTaskCreate(Task5,
//	  		  				"Task5",
//	  		  				STACK_SIZE,
//	  						(uint8_t *)&Tasknum,
//	  		  				tskIDLE_PRIORITY + 1,
//	  		  				&task1Handle5) == pdFAIL)
//		{
//			while(1);
//		}

	  	vTaskStartScheduler();
}

