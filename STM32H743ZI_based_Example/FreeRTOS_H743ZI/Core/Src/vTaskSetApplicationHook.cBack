#include "main.h"

uint8_t data[70] = {};
volatile uint8_t Tasknum= 0;

#define STACK_SIZE 256

TaskHandle_t task1Handle;
TaskHandle_t task1Handle2;
TaskHandle_t task1Handle3;

static BaseType_t prvExampleTaskHook( void * pvParameter )
{
    /* Perform some action - this could be anything from logging a value,
       updating the task state, outputting a value, etc. */
	//HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
	uint8_t ptrdata = *(uint8_t *)pvParameter;


    return 0;
}

void monitorTask(void *para)
{
	BaseType_t delaystate;
	uint8_t ptrdata = *(volatile uint8_t *)para;

	vTaskSetApplicationTaskTag(NULL, prvExampleTaskHook);

	sprintf((char*)data, "Task1Data:- %d\r\n", (int)ptrdata);
	HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));

	TickType_t tickCount = xTaskGetTickCount();
	while(1)
	{
		delaystate = xTaskDelayUntil(&tickCount, pdMS_TO_TICKS(1000));
		if(delaystate == pdTRUE)
		{
			  HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
		}
	}
}

void Task2 (void* para)
{
	BaseType_t delaystate;
	uint8_t ptrdata = *(volatile uint8_t *)para;

	vTaskSetApplicationTaskTag(NULL, prvExampleTaskHook);

	sprintf((char*)data, "Task2Data:- %d\r\n", (int)ptrdata);
	HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));

	TickType_t tickCount = xTaskGetTickCount();
	while(1)
	{
		delaystate = xTaskDelayUntil(&tickCount, pdMS_TO_TICKS(1000));
		if(delaystate == pdTRUE)
		{
			HAL_GPIO_TogglePin(LD0_GPIO_Port, LD0_Pin);
		}
	}
}

void Task3 (void* para)
{
	uint8_t ptrdata = *(volatile uint8_t *)para;
	TaskStatus_t stat;
	BaseType_t delaystate;
	uint8_t cal = 0;

	vTaskSetApplicationTaskTag(NULL, prvExampleTaskHook);

	sprintf((char*)data, "Task3Data:- %d\r\n", (int)ptrdata);
	HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));

	TickType_t tickCount = xTaskGetTickCount();
	while(1)
	{
		delaystate = xTaskDelayUntil(&tickCount, pdMS_TO_TICKS(500));
		if(delaystate == pdTRUE)
		{
			HAL_GPIO_TogglePin(LD1_GPIO_Port, LD1_Pin);
		}
		cal++;
		if(cal > 20)
		{
			cal = 0;
			vTaskGetInfo(
					/*Get the current Task Info*/
					NULL,
					/*Pass the state structure to be filled*/
					&stat,
					/*Get the Stack high watermark*/
					pdTRUE,
					/*Also include the task state*/
					eInvalid);
			sprintf((char*)data, "Name:- %s, WaterMark:- %ld\r\n", (char*)stat.pcTaskName, (long)stat.usStackHighWaterMark);
			HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
		}
	}
}


void FreeRTOSTestFun(uint8_t val)
{

	 if(xTaskCreate(monitorTask,
	  			"SampleTask",
	  			STACK_SIZE,
	  			(volatile uint8_t *)&Tasknum,
	  			tskIDLE_PRIORITY + 4,
	  			&task1Handle) == pdFAIL)
	  	{
	  	// Task created
	  		while(1);
	  	}

	    Tasknum = 10;
	  	if(xTaskCreate(Task2,
	  				"Task2",
	  				STACK_SIZE,
					&Tasknum,
	  				tskIDLE_PRIORITY + 2,
	  				&task1Handle2) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	Tasknum = 20;
	  	if(xTaskCreate(Task3,
	  				"Task3",
	  				STACK_SIZE,
					&Tasknum,
	  				tskIDLE_PRIORITY + 1,
	  				&task1Handle3) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	vTaskStartScheduler();
}

/* USER CODE BEGIN 4 */
void vApplicationStackOverflowHook(TaskHandle_t xTask, char *pcTaskName) {
    // Trigger a breakpoint or reset the system here
    while (1) {
		//GPIO_TogglePin(GPIOC, GPIO_PIN_9);
			//Delay_ms(1000);
	}
}

#if (configUSE_IDLE_HOOK == 1)
void vApplicationIdleHook(void) {
    // This runs whenever no other task is ready to run
    // Enter Sleep Mode
    //__WFI();
	HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
}
#endif

void vApplicationMallocFailedHook(void)
{
    while(1)
    {
        /* Memory exhausted */
    	while(1);
    }
}
