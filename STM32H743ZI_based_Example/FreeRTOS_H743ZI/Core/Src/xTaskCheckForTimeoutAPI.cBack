bool vaitForTicks(int vaitTick)
{
	TimeOut_t xTimeOut;
	TickType_t WaitTicks = pdMS_TO_TICKS(vaitTick);

	vTaskSetTimeOutState(&xTimeOut);
	while(1)
	{
		if(xTaskCheckForTimeOut(&xTimeOut, &WaitTicks) == pdTRUE)
		{
			HAL_UART_Transmit_IT(&huart3, (const uint8_t *)"High Priority Task..\r\n", strlen((const char *)"High Priority Task..\r\n"));
			return 1;
		}
		ulTaskNotifyTake( pdTRUE, WaitTicks );
	}
	return 0;
}

void monitorTask(void *para)
{

	while(1)
	{
		if(vaitForTicks(1000))
		{
			HAL_GPIO_TogglePin(LD0_GPIO_Port, LD0_Pin);
		}
	}
}

void HighpriorityProcess(void)
{
	//taskENTER_CRITICAL();
	HAL_UART_Transmit_IT(&huart3, (const uint8_t *)"Hogh Priority Process Done..\r\n", strlen((const char *)"High Priority Process Done..\r\n"));
	//taskEXIT_CRITICAL();
}

void Task2 (void* para)
{
	BaseType_t delaystate;
	TickType_t reftime = xTaskGetTickCount();
	while(1)
	{
		if(xTaskDelayUntil(&reftime, pdMS_TO_TICKS(1000)) == pdTRUE)
		{
			HAL_GPIO_TogglePin(LD1_GPIO_Port, LD1_Pin);
			HighpriorityProcess();
		}
	}
}

