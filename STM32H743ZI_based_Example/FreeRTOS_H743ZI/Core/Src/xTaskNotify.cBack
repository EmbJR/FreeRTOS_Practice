void FreeRTOSTestFun(uint8_t val)
{

	 if(xTaskCreate(monitorTask,
	  			"SampleTask",
	  			STACK_SIZE,
	  			(uint8_t *)&Tasknum,
	  			tskIDLE_PRIORITY + 3,
	  			&task1Handle) == pdFAIL)
	  	{
	  	// Task created
	  		while(1);
	  	}

	    Tasknum = 10;
	  	if(xTaskCreate(Task2,
	  				"Task2",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 2,
	  				&task1Handle2) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	Tasknum = 20;
	  	if(xTaskCreate(Task3,
	  				"Task3",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 1,
	  				&task1Handle3) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	if(xTaskCreate(Task4,
	  		  				"Task4",
	  		  				STACK_SIZE,
	  						(uint8_t *)&Tasknum,
	  		  				tskIDLE_PRIORITY + 1,
	  		  				&task1Handle4) == pdFAIL)
		{
			while(1);
		}

//	  	if(xTaskCreate(Task5,
//	  		  				"Task5",
//	  		  				STACK_SIZE,
//	  						(uint8_t *)&Tasknum,
//	  		  				tskIDLE_PRIORITY + 1,
//	  		  				&task1Handle5) == pdFAIL)
//		{
//			while(1);
//		}

	  	vTaskStartScheduler();
}

