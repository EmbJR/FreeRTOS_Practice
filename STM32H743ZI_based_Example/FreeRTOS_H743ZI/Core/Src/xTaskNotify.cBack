#include "main.h"

#define NOTIFY_01	(1UL << 0UL)
#define NOTIFY_02	(1UL << 1UL)
#define NOTIFY_03	(1UL << 2UL)
#define NOTIFY_04	(1UL << 3UL)
#define NOTIFY_05	(1UL << 4UL)
#define NOTIFY_CLRALL	0x1FUL
#define NOTIFY_CLENONE	0x00UL

#define USE_QUERY	1


uint8_t data[70] = {};
volatile uint8_t Tasknum= 0;

#define STACK_SIZE 256

TaskHandle_t task1Handle;
TaskHandle_t task1Handle2;
TaskHandle_t task1Handle3;
TaskHandle_t task1Handle4;

