void monitorTask(void *para)
{
	uint8_t delta = 0;
	uint32_t prevNotifyValue;
	while(1)
	{
		vTaskDelay(200);
		delta++;
		if(delta == 10)
		{
#if USE_QUERY == 0 // don't use query..
			xTaskNotifyIndexed(task1Handle2, NOTIFY_01, 20, eSetBits);
#else // Use notify with query..
			xTaskNotifyAndQueryIndexed(task1Handle2, NOTIFY_01, 20, eSetBits, &prevNotifyValue);
#endif
			vTaskDelay(180);
		}
		else if(delta == 20)
		{
#if USE_QUERY == 0 // don't use query..
			xTaskNotifyIndexed(task1Handle2, NOTIFY_02, 30, eSetBits);
#else // Use notify with query..
			xTaskNotifyAndQueryIndexed(task1Handle2, NOTIFY_02, 30, eSetBits, &prevNotifyValue);
#endif
			vTaskDelay(180);
#if USE_QUERY == 0 // don't use query..
			xTaskNotify(task1Handle3, 0x50, eSetValueWithOverwrite);
#else // Use notify with query..
			xTaskNotifyAndQuery(task1Handle3, 0x50, eSetValueWithOverwrite, NULL);
#endif

		}
		else if(delta == 30)
		{
#if USE_QUERY == 0 // don't use query..
			xTaskNotifyIndexed(task1Handle2, NOTIFY_03, 40, eSetBits);
#else // Use notify with query..
			xTaskNotifyAndQueryIndexed(task1Handle2, NOTIFY_03, 40, eSetBits, &prevNotifyValue);
#endif
			vTaskDelay(180);
#if USE_QUERY == 0 // don't use query..
			if(xTaskNotify(task1Handle4, 0x60, eSetValueWithoutOverwrite) == pdPASS)
			{
				// Task notification value updated
			}
			else
			{
				// Task notification value not updated
				vTaskDelay(10);
			}
			//xTaskNotifyStateClear( task1Handle4); By clearing the notification value, you will get success in the below API.
			if(xTaskNotify(task1Handle4, 0x70, eSetValueWithoutOverwrite) == pdPASS)
			{
				// Task notification value updated
			}
			else
			{
				// Task notification value not updated
				vTaskDelay(10);
			}
#else // Use notify with query..
			if(xTaskNotifyAndQuery(task1Handle4, 0x60, eSetValueWithoutOverwrite, &prevNotifyValue) == pdPASS)
			{
				// Task notification value updated
			}
			else
			{
				// Task notification value not updated
				vTaskDelay(10);
			}
			//xTaskNotifyStateClear( task1Handle4); By clearing the notification value, you will get success in the below API.
			if(xTaskNotifyAndQuery(task1Handle4, 0x70, eSetValueWithoutOverwrite, &prevNotifyValue) == pdPASS)
			{
				// Task notification value updated
			}
			else
			{
				// Task notification value not updated
				vTaskDelay(10);
			}

#endif
			vTaskDelay(180);
			xTaskNotifyGive(task1Handle3);
			delta = 0;
		}
	}
}


void Task2 (void* para)
{
	uint32_t noTificationVal;
	TickType_t reftime = xTaskGetTickCount();
	while(1)
	{
		if(xTaskNotifyWaitIndexed(	NOTIFY_01,
									0x00,
									0xFFFFFFFF,
									&noTificationVal,
									pdMS_TO_TICKS(10)))
		{

			sprintf((char*)data, "Notiy 2-1 Val = %d\r\n", (int)noTificationVal);
			HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
		}
		if(xTaskNotifyWaitIndexed(	NOTIFY_02,
									0x00,
									0xFFFFFFFF,
									&noTificationVal,
									pdMS_TO_TICKS(10)))
		{
			sprintf((char*)data, "Notiy 2-2 Val = %d\r\n", (int)noTificationVal);
		    HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
		}
		if(xTaskNotifyWaitIndexed(	NOTIFY_03,
									0x00,
									0xFFFFFFFF,
									&noTificationVal,
									pdMS_TO_TICKS(10)))
		{
			sprintf((char*)data, "Notiy 2-3 Val = %d\r\n", (int)noTificationVal);
		    HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
		}
	}
}

void Task3 (void* para)
{
	uint32_t noTificationVal;
	uint8_t ptrdata = *(volatile uint8_t *)para;

	while(1)
	{

		if(xTaskNotifyWait(	0,
							0xFFFFFFFF,
							&noTificationVal,
							portMAX_DELAY))
		{
			if(noTificationVal != 0)
			{
				sprintf((char*)data, "Notiy 3- Val=%d\r\n", (int)noTificationVal);
			    HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
			}
		}
	}
}

void Task4 (void* para)
{
	uint32_t noTificationVal;
	vTaskDelay(10000);
	while(1)
	{
		if(xTaskNotifyWait(	0,
							0xFFFFFFFF,
							&noTificationVal,
							portMAX_DELAY))
		{
			if(noTificationVal != 0)
			{
				sprintf((char*)data, "Notiy 4- Val=%d\r\n", (int)noTificationVal);
				HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
			}
		}
	}
}

