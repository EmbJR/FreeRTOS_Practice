void monitorTask(void *para)
{
	uint8_t ReceivedData1[50] = {0};
	uint8_t ReceivedData2[50] = {0};
	size_t xReceiveDatacnt;

	vTaskDelay(5000);
	while(1)
	{
//----------------------------- Receive data to Buffer 1 ------------------------------//
		xReceiveDatacnt = xStreamBufferReceive(	sBufferHandle,
												(void *)ReceivedData1,
												sizeof(ReceivedData1),
												pdMS_TO_TICKS(100));
		if(xReceiveDatacnt > 0 )
		{
			HAL_UART_Transmit_IT(&huart3, (const uint8_t *)ReceivedData1, strlen((const char *)ReceivedData1));
			vTaskDelay(100); // required to give some time for printing.

			/*-------- After ~3 receive, delete the buffer ------------*/
			//vStreamBufferDelete();
			memset((char *)ReceivedData1, 0x00, sizeof(ReceivedData1));
		}
//----------------------------- Receive data to Buffer 2 ------------------------------//
		xReceiveDatacnt = xStreamBufferReceive(	xSteamBufferCustHanle,
												(void *)ReceivedData2,
												sizeof(ReceivedData2),
												pdMS_TO_TICKS(100));
		if(xReceiveDatacnt > 0 )
		{
			HAL_UART_Transmit_IT(&huart3, (const uint8_t *)ReceivedData2, strlen((const char *)ReceivedData2));
			vTaskDelay(100); // required to give some time for printing.

			/*-------- After ~3 receive, delete the buffer ------------*/
			//vStreamBufferDelete();
			memset((char *)ReceivedData2, 0x00, sizeof(ReceivedData2));
		}

	}
}


void Task2 (void* para)
{
	size_t xStreamBufferSent;
	uint8_t DataValue1[] = {'0', '1', '2', '3', '4'};
	uint8_t *DataValue2 = "String to send123456";
	uint8_t cnt = 0;

	while(1)
	{
//----------------------------- Send data to Buffer 1 ------------------------------//
		xStreamBufferSent = xStreamBufferSend(	sBufferHandle,
												DataValue1,
												sizeof(DataValue1),
												pdMS_TO_TICKS(100));
		if(xStreamBufferSent != sizeof(DataValue1))
		{
			/*The call to xStreamBufferSend() times out before there was enough
	           space in the buffer for the data to be written, but it did
	           successfully write xStreamBufferSent bytes*/
			vTaskDelay(10);
		}
//----------------------------- Send data to Buffer 2 ------------------------------//
		if(xStreamBufferIsFull(xSteamBufferCustHanle) != pdTRUE)
		{
			xStreamBufferSent = xStreamBufferSend(	xSteamBufferCustHanle,
													DataValue2,
													strlen(DataValue2),
													pdMS_TO_TICKS(100));
			if(xStreamBufferSent != sizeof(DataValue2))
			{
				/*The call to xStreamBufferSend() times out before there was enough
				   space in the buffer for the data to be written, but it did
				   successfully write xStreamBufferSent bytes*/
				vTaskDelay(10);
			}
		}

//		xStreamBufferSent = xStreamBufferSend(	sBufferHandle,
//												DataValue2,
//												strlen((const char *)DataValue2),
//												pdMS_TO_TICKS(100));
//		if(xStreamBufferSent != strlen((const char *)DataValue2))
//		{
//			/*The entire string could not be added to the stream buffer because
//           there was not enough free space in the buffer, but xStreamBufferSent bytes
//           were sent. Could try again to send the remaining bytes.*/
//			vTaskDelay(10);
//		}


		vTaskDelay(4000);
	}
}

