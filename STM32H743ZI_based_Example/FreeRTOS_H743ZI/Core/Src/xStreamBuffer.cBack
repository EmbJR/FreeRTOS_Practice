void vSendCallbackFunction(	StreamBufferHandle_t  xHandle,
						 	BaseType_t isInISR,
							BaseType_t * const xHighPriorityTaskWoken)
{
	vTaskDelay(10);
}

void vReceiveCallbackFunction(	StreamBufferHandle_t  xHandle,
						 		BaseType_t isInISR,
								BaseType_t * const xHighPriorityTaskWoken)
{
	vTaskDelay(10);
}


void FreeRTOSTestFun(uint8_t val)
{

	const size_t xStreamBuffSize = 100, xStreamBuffTrgLvl = 10;

	sBufferHandle = xStreamBufferCreate(xStreamBuffSize, xStreamBuffTrgLvl);
	if(sBufferHandle == NULL)
	{
		// error Creating Stream Buffer
	}
	xSteamBufferCustHanle = xStreamBufferCreateWithCallback(xStreamBuffSize,
															xStreamBuffTrgLvl,
															vSendCallbackFunction,
															vReceiveCallbackFunction );

	//----------------------------- Resets the Bufer Levels of "xSteamBufferCustHanle" ------------------------------//
	if(xStreamBufferSetTriggerLevel(xSteamBufferCustHanle, 20) != pdPASS)
	{
		vTaskDelay(10);
	}
	//----------------------------- Check for the idle condition and delete the "xSteamBufferCustHanle" ------------------------------//
	size_t availableSpace2 = xStreamBufferSpacesAvailable(xSteamBufferCustHanle);
	size_t availableBytes = xStreamBufferBytesAvailable(xSteamBufferCustHanle);
	if(availableBytes == 0 && availableSpace2 == 100)
	{
		//--------------------------- This will delete the bufer, Don't enable it to use "xSteamBufferCustHanle" ---------------------//
		//-- A stream buffer can only be delete/reset if there are no tasks blocked waiting to either send to or receive from the stream buffer.//
		//vStreamBufferDelete(xSteamBufferCustHanle);
	}

	 if(xTaskCreate(monitorTask,
	  			"SampleTask",
	  			STACK_SIZE,
	  			(uint8_t *)&Tasknum,
	  			tskIDLE_PRIORITY + 3,
	  			&task1Handle) == pdFAIL)
	  	{
	  	// Task created
	  		while(1);
	  	}

	    Tasknum = 10;
	  	if(xTaskCreate(Task2,
	  				"Task2",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 2,
	  				&task1Handle2) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	Tasknum = 20;
	  	if(xTaskCreate(Task3,
	  				"Task3",
	  				STACK_SIZE,
					(uint8_t *)&Tasknum,
	  				tskIDLE_PRIORITY + 1,
	  				&task1Handle3) == pdFAIL)
	  	{
	  		while(1);
	  	}

	  	if(xTaskCreate(Task4,
	  		  				"Task4",
	  		  				STACK_SIZE,
	  						(uint8_t *)&Tasknum,
	  		  				tskIDLE_PRIORITY + 1,
	  		  				&task1Handle4) == pdFAIL)
		{
			while(1);
		}

//	  	if(xTaskCreate(Task5,
//	  		  				"Task5",
//	  		  				STACK_SIZE,
//	  						(uint8_t *)&Tasknum,
//	  		  				tskIDLE_PRIORITY + 1,
//	  		  				&task1Handle5) == pdFAIL)
//		{
//			while(1);
//		}

	  	vTaskStartScheduler();
}

