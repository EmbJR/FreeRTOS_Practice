void monitorTask(void *para)
{
	uint8_t value = 0;

	vTaskDelay(2000);
	//HAL_Delay(2000);
	sprintf((char*)data, "High_Value = %d\r\n", (int)value);
	HAL_UART_Transmit_IT(&huart3, (const uint8_t *)data, strlen((const char *)data));
	value++;
	while(1)
	{
		HAL_GPIO_TogglePin(LD0_GPIO_Port, LD0_Pin);
		vTaskDelay(100);
	}
}

void HighpriorityProcess(void)
{
	uint32_t tickval = HAL_GetTick();
	taskENTER_CRITICAL();
	HAL_Delay(1000);
	taskEXIT_CRITICAL();
	/* Since "monitorTask" having the delay of 2 seconds, the print on uart ("High_Value =..") will apear near about ~1.8 seconds after
	 * the  "taskEXIT_CRITICAL()"
	 * If "xTaskCatchUpTicks()" used to suppress the delay created bas critical sections,
	 * the print on uart ("High_Value =..") will appear earlier at ~500ms after exiting from
	 * critical section and executing the print on uart at the near exact time.*/
	if(xTaskCatchUpTicks(HAL_GetTick() - tickval)  == pdTRUE)
	{
		HAL_UART_Transmit_IT(&huart3, (const uint8_t *)"TimeAdjusted\r\n", strlen((const char *)"TimeAdjusted\r\n"));
	}
}

void Task2 (void* para)
{
	BaseType_t delaystate;
	TickType_t reftime = xTaskGetTickCount();
	while(1)
	{
		if(xTaskDelayUntil(&reftime, pdMS_TO_TICKS(1000)) == pdTRUE)
		{
			HAL_GPIO_TogglePin(LD1_GPIO_Port, LD1_Pin);
			HighpriorityProcess();
		}
	}
}

void Task3 (void* para)
{
	uint8_t ptrdata = *(volatile uint8_t *)para;
	while(1)
	{
	}
}


